# true: use mock data from src/mocks. false: call the Python backend.
NEXT_PUBLIC_USE_MOCKS=true
# The backend. The browser reaches it through this site (/api/backend); on Vercel: https://geo-api.shopsready.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Parts of the API the backend already serves while the rest stay on mocks, comma-separated.
# "auth": login by a code sent to an email. "first-run": a new account's first run (needs "auth").
# Both need the backend running (backend/README.md). Empty: everything is a mock.
NEXT_PUBLIC_LIVE=
